PREFIX :<http://www.ontotext.com/connectors/lucene#>
PREFIX inst:<http://www.ontotext.com/connectors/lucene/instance#>
# Conditional drop: only fires if the connector already exists.
INSERT { inst:expressionsIndex :dropConnector "" }
WHERE { inst:expressionsIndex :connectorStatus ?status }
;
PREFIX :<http://www.ontotext.com/connectors/lucene#>
PREFIX inst:<http://www.ontotext.com/connectors/lucene/instance#>
# language, contentType, workType and genre hold category IRIs, not
# analyzed, for the search filters and their counts (lucene:facetFields).
# Work type and genre follow entedit:P01/P02 rather than their common
# superproperty rdaw:P10004, which would mix the two in one list. A field
# name with $ merges into the part before it: workType$direct and
# workType$inverse are one field, reached from either side of the link.
# expression (the entity's own IRI, $self) and work hold IRIs for following a
# link from a search result: the search is limited to the linked expression
# or to the expressions of the linked work (+work:"<IRI>"), and the label's
# words only rank the hits.
# documentFilter keeps expressions whose work is a selection (entedit:T07, a
# retrospective collection of works that exist on their own) out of this index,
# so they are neither found in the content search nor offered as a category. The
# publication search (manifestationsIndex) is not affected. `genre` is the merged
# field genre$direct/genre$inverse. UNTESTED: check on a repository that T07
# expressions are gone, others (also with several genres or none) are kept.
INSERT DATA {
	inst:expressionsIndex :createConnector '''
{
  "fields": [
    {
      "fieldName": "names$manifestation",
      "propertyChain": [
        "http://rdaregistry.info/Elements/e/object/P20059",
        "http://rdaregistry.info/Elements/x/object/P00006",
        "http://rdaregistry.info/Elements/x/P00019"
