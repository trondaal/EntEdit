PREFIX :<http://www.ontotext.com/connectors/lucene#>
PREFIX inst:<http://www.ontotext.com/connectors/lucene/instance#>
# Conditional drop: only fires if the connector already exists.
INSERT { inst:worksIndex :dropConnector "" }
WHERE { inst:worksIndex :connectorStatus ?status }
;
PREFIX :<http://www.ontotext.com/connectors/lucene#>
PREFIX inst:<http://www.ontotext.com/connectors/lucene/instance#>
# Works, for the work search. A work is indexed like the work part of an
# expression in expressionsIndex: its titles, labels and agents, and those of
# the works it is related to (transformation, augmentation, whole/part), plus
# everything of its expressions — titles, labels, agents (translators,
# narrators), source expressions, language and content type. Each expression
# is reached from either side of the link (rdawo:P10078 or rdaeo:P20231);
# a field name with $ merges into the part before it, so names$expression_fromWork
# and names$work are both the field `names`. Manifestations are left out on
# purpose: a work with many publications would gather their titles, publishers
# and statements of responsibility and match far too broadly.
# language, contentType, workType and genre hold category IRIs, not analyzed,
# for the search filters and their counts (lucene:facetFields); a work counts
# once per language or content type that any of its expressions has. Work type
# and genre follow entedit:P01/P02, not their superproperty rdaw:P10004.
# work ($self) and expression hold IRIs for following a link from a search
# result: +work:"<IRI>" finds the work, +expression:"<IRI>" the work of an
# expression.
# Unlike expressionsIndex there is no documentFilter: the work search is the
# full overview of everything entered as a work, selections (entedit:T07)
# included.
INSERT DATA {
	inst:worksIndex :createConnector '''
{
  "fields": [
    {
      "fieldName": "names$work",
      "propertyChain": [
        "http://rdaregistry.info/Elements/x/object/P00006",
        "http://rdaregistry.info/Elements/x/P00019"
      ],
      "indexed": true,
      "stored": true,
      "analyzed": true,
      "multivalued": true,
      "ignoreInvalidValues": false,
      "facet": true
    },
    {
      "fieldName": "names$expression_fromWork",
      "propertyChain": [
        "http://rdaregistry.info/Elements/w/object/P10078",
