@prefix entedit: <http://oslomet.no/abi/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdac: <http://rdaregistry.info/Elements/c/> .
@prefix rdaao: <http://rdaregistry.info/Elements/a/object/> .
@prefix rdawo: <http://rdaregistry.info/Elements/w/object/> .
@prefix rdaeo: <http://rdaregistry.info/Elements/e/object/> .
@prefix rdamo: <http://rdaregistry.info/Elements/m/object/> .
@prefix rdaio: <http://rdaregistry.info/Elements/i/object/> .
@prefix rdaad: <http://rdaregistry.info/Elements/a/datatype/> .
@prefix rdawd: <http://rdaregistry.info/Elements/w/datatype/> .
@prefix rdaed: <http://rdaregistry.info/Elements/e/datatype/> .
@prefix rdamd: <http://rdaregistry.info/Elements/m/datatype/> .
@prefix rdaid: <http://rdaregistry.info/Elements/i/datatype/> .

entedit:StatusLiteral a rdfs:Datatype ;
    owl:oneOf ("core wemi property" "data property" "object property" "class" "controlled property" "deprecated" "not used") .

entedit:status
    a owl:DatatypeProperty ;
    rdfs:range entedit:StatusLiteral ;
    rdfs:label "has status (literal)" .

entedit:order
    a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "has display order (integer)" .

# entedit:linguistic false marks values that are not natural language (dates,
# numbering, measurements, identifiers): the editor then offers no language
# selector for them. Properties without the annotation count as linguistic.
entedit:linguistic
    a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "is linguistic (boolean)" .


# entedit:display false can be used to mark one direction of a relationship pair
# (e.g. "has subject work" / "is subject work of") that should not be shown in the result presentation
# Symmetric pairs like "is part of" / "has part" are left unannotated, since
# both directions are wanted. Properties without the annotation count as
# displayed.
entedit:display
    a owl:DatatypeProperty ;
    rdfs:range xsd:boolean ;
    rdfs:label "is displayed (boolean)" .

#Adding some classes for the vocabularies used to facilitate filtering by range
entedit:Contenttype
  a owl:Class ;
  rdfs:label "Innholdstype"@no, "Content type"@en .

entedit:Carriertype
  a owl:Class ;
  rdfs:label "Bærertype"@no, "Carrier types"@en .

entedit:Mediatype
  a owl:Class ;
  rdfs:label "Medietype"@no, "Media type"@en .

entedit:Language
  a owl:Class ;
  rdfs:label "Språk"@no, "Language"@en .

entedit:Worktype
  a owl:Class ;
  rdfs:label "Kategori av verk"@no, "Category of work"@en .

entedit:Genretype
  a owl:Class ;
  rdfs:label  "Sjanger og form"@no, "Genre and form"@en .

entedit:P01
  a rdf:Property ;
  entedit:status "controlled property" ;
  rdfs:subPropertyOf rdawo:P10004 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10001> ;
  rdfs:range entedit:Worktype ;
  rdfs:label "Verkskategori"@no, "Category of work"@en.

entedit:P02
  a rdf:Property ;
  entedit:status "controlled property" ;
  rdfs:subPropertyOf rdawo:P10004 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10001> ;
  rdfs:range entedit:Genretype ;
  rdfs:label "Sjanger eller form"@no, "Genre or form"@en.

# Specific contributor roles for manifestations. RDA offers only the generic
# "has contributor agent of text / still image"; these sub-properties name the
# role, and inference still yields the generic RDA relationship. Each has an
# inverse, so the relationship shows from the agent's side as well.

entedit:P03
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdamo:P30328 ;
  owl:inverseOf entedit:P04 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:label "har forfatter av innledning"@no, "has author of introduction"@en.

entedit:P04
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdaao:P50475 ;
  owl:inverseOf entedit:P03 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:label "er forfatter av innledning i"@no, "is author of introduction in"@en.

entedit:P05
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdamo:P30321 ;
  owl:inverseOf entedit:P06 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:label "har illustratør"@no, "has illustrator"@en.

entedit:P06
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdaao:P50469 ;
  owl:inverseOf entedit:P05 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:label "er illustratør i"@no, "is illustrator in"@en.

# Forewords, afterwords, and notes or commentary (including bibliographies and
# chronologies): further roles under "has contributor agent of text".

entedit:P07
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdamo:P30328 ;
  owl:inverseOf entedit:P08 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:label "har forfatter av forord"@no, "has author of foreword"@en.

entedit:P08
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdaao:P50475 ;
  owl:inverseOf entedit:P07 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:label "er forfatter av forord i"@no, "is author of foreword in"@en.

entedit:P09
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdamo:P30328 ;
  owl:inverseOf entedit:P10 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:label "har forfatter av etterord"@no, "has author of afterword"@en.

entedit:P10
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdaao:P50475 ;
  owl:inverseOf entedit:P09 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:label "er forfatter av etterord i"@no, "is author of afterword in"@en.

entedit:P11
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdamo:P30328 ;
  owl:inverseOf entedit:P12 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:label "har kommentator"@no, "has annotator"@en.

entedit:P12
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdaao:P50475 ;
  owl:inverseOf entedit:P11 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:label "er kommentator i"@no, "is annotator in"@en.

# Photographs: a further role under "has contributor agent of still image".

entedit:P13
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdamo:P30321 ;
  owl:inverseOf entedit:P14 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:label "har fotograf"@no, "has photographer"@en.

entedit:P14
  a rdf:Property ;
  entedit:status "object property" ;
  rdfs:subPropertyOf rdaao:P50469 ;
  owl:inverseOf entedit:P13 ;
  rdfs:domain <http://rdaregistry.info/Elements/c/C10002> ;
  rdfs:range <http://rdaregistry.info/Elements/c/C10007> ;
  rdfs:label "er fotograf i"@no, "is photographer in"@en.

