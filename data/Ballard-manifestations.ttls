man:180365
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/180365",
        "https://www.isfdb.org/cgi-bin/pl.cgi?180365" ;
    rdfs:label "Cocaine Nights (Flamingo, 1997)" ;
    rdamd:P30156 "Cocaine Nights"@en ;
