man:415058
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/415058",
        "https://www.isfdb.org/cgi-bin/pl.cgi?415058" ;
    rdfs:label "Il Dio del 36º piano (Mondadori, 1968)" ;
    rdamd:P30156 "Il Dio del 36º piano"@it ;
    rdamd:P30117 "edited by Carlo Fruttero ; Franco Lucentini" ;
    rdamd:P30176 "Mondadori" ;
    rdamd:P30011 "1968-07-30" ;
    rdamd:P30182 "322 p." ;
    rdamd:P30004 "7739" ;
    rdamd:P30106 "Oscar" ;
    rdamd:P30014 "168" ;
    rdamd:P30137 "\"Il Dio del 36° piano\", subtitled \"Storie del futuro prossimo\" is an original Italian anthology. Contains:\n• The Day Rembrandt Went Public translated by Beata Della Frattina as \"Rembrandt S.p.A.\"\n• Billennium translated by Beata Della Frattina as \"C'è posto per tutti\"\n• Gadget Versus Trend translated by Cesare Scaglia as \"Tutti contro tutti\"\n• Romance in a Twenty-First Century Used-Car Lot translated by Bianca Russo as \"L'auto addosso\"\n• The Ear-Friend translated by Antonangelo Pinna as \"Condizionamento\"\n• The Carson Effect translated by Beata Della Frattina as \"L'effetto Carson\"\n• Security Syndrome translated by Enrica La Viola as \"Autodelatore\"\n• Dodkin's Job translated by Bianca Russo as \"Per chi lavoriamo\"\n• Still Life translated by Beata Della Frattina as \"Per che cosa ci pagano\"\n• Final Clearance translated by Bianca Russo as \"Le carte in regola\"\n• The God on the 36th Floor translated by Bianca Russo as \"Il Dio del 36° piano\"\n• The Census Takers translated by Bianca Russo as \"Censimento\"\n• To the Chicago Abyss translated by Beata Della Frattina as \"L'abisso di Chicago\"\nData from http://www.fantascienza.com; catalog number from http://www.catalogovegetti.com" ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:4472 ;
