man:253161
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/253161",
        "https://www.isfdb.org/cgi-bin/pl.cgi?253161" ;
    rdfs:label "Re/Search: J. G. Ballard (RE/Search Publications, 1984)" ;
    rdamd:P30156 "Re/Search: J. G. Ballard"@en ;
    rdamd:P30117 "Andrea Juno ; Vale ; J. G. Ballard ; David Pringle" ;
    rdamd:P30176 "RE/Search Publications" ;
    rdamd:P30011 "1984" ;
    rdamd:P30182 "171+[5] p." ;
    rdamd:P30004 "ISBN 0940642085" ;
    rdamd:P30137 "Large Format trade paperback (identical to European A4 format).\n\"No 8/9\" only stated on cover and spine, not on the title page.\n\"Editors: Vale; Andrea Juno\", \"Associate Publisher: Scott X. Summerville\" & \"Guest Contributing Editor: David Pringle\" stated on the copyright page (p. 2), which also serves as title page.\nISBN on spine and copyright page.\nNo stated date of publication (other than the copyright assignment of 1984 to the publisher & contributors).\nCredits for the interviews taken from contents page (p. 3).\nThe Scoggins interview only takes p. 50 and is credited in the surrounding interview by Revell.\nThe different sections (\"Interviews\", \"Fiction\", \"Non-Fiction\" etc.) have their respective own title pages.\n\"Back and Front Cover Photos & Photos on first and last pages: Ana Barrado\" stated on the copyright page.\n\"Book Design & Layout: Andrea Juno\" and \"Cover Design: Rebecca Wilson\" stated on the copyright page.\nCopiously illustrated; art only included in this entry when credited.\n\"Photographers: Bobby Adams, Ana Barrado\" stated on the copyright page.\nPrice on spine." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
