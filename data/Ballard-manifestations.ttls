man:257313
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/257313",
        "https://www.isfdb.org/cgi-bin/pl.cgi?257313" ;
    rdfs:label "Cyber-Killers (Millennium / Orion, 1997)" ;
    rdamd:P30156 "Cyber-Killers"@en ;
    rdamd:P30117 "edited by Ric Alexander" ;
    rdamd:P30176 "Millennium / Orion" ;
    rdamd:P30011 "1997-06" ;
    rdamd:P30182 "viii+408 p." ;
    rdamd:P30004 "ISBN 0752807838" ;
    rdamd:P30137 "On copyright page: \"First published in Great Britain in 1997 by Orion\" and ISBNs for this hardcover edition and the \"trade paperback\" edition.\nPrice on front flap of jacket. \"Cover Design: Blacksheep\" on back flap.\nVerification copy has a publisher's \"ERRATA\" sticker on title page with a correction to the acknowledgement for Iain M. Banks' The State of the Art.\nThe \"Menu\" (contents page) groups the stories into three sections. The title page for the first section, \"Network Terrorists\" (page 1), has an Isaac Asimov quote from \"Crime Up To Date (1983)\". The title page for the second section, \"Robot Crime\" (page 149) has a Philip K. Dick quote from \"The Android and the Human (1973)\". The title page for the third section \"Virtual Murder\" (page 301) has a quote by Barrie Sherman & Phil Judkins from \"Glimpses of Heaven, Visions of Hell (1992)\"." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:164 ;
