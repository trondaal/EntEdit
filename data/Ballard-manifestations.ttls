man:1098657
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/1098657",
        "https://www.isfdb.org/cgi-bin/pl.cgi?1098657" ;
    rdfs:label "Gefährliche Visionen (Carcosa Verlag, 2026)" ;
    rdamd:P30156 "Gefährliche Visionen"@de ;
    rdamd:P30117 "edited by Harlan Ellison" ;
    rdamd:P30176 "Carcosa Verlag" ;
    rdamd:P30011 "2026-01-27" ;
    rdamd:P30182 "782 p." ;
    rdamd:P30004 "ISBN 9783910914421",
        "OCLC/WorldCat 1523150140",
        "DNB 136773357X" ;
    rdamd:P30137 "First German edition (\"Deutsche Erstausgabe\" is stated on the copyright page), being the first time that all titles are published in a single volume in German.\nAssumed first printing (not stated).\nAll titles have been newly translated for this edition.\nAlmost all translations of the story's introductions and afterwords were done by Hannes Riffel, whereas the translations of the stories were done by varying translators.\nAlmost all introductions and afterwords are published for the first time in German with this edition (according to the list of sources).\nLists of contents on pages 5-6.\nDavid R. Bunch's two stories are not listed as separate stories but as Ein Vorfall in Moderan | Ausbruch in the list of contents and on the introduction page 433.\nPages 775-782 contain a list of sources (\"Quellenverzeichnis\"), stating for each title: original title, translator and titles of previous German translations and translator for this edition.\nThe cover artist is stated on the copyright page.\nThe price is for Germany. Other price: €49.40 (Austria).\nA publication date is not stated in the book but was taken from buchhandel.de" ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:82832 ;
