man:558686
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/558686",
        "https://www.isfdb.org/cgi-bin/pl.cgi?558686" ;
    rdfs:label "Crash (Edition Phantasia, 1985)" ;
    rdamd:P30156 "Crash"@de ;
