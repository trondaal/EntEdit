man:420170
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/420170",
        "https://www.isfdb.org/cgi-bin/pl.cgi?420170" ;
    rdfs:label "Horror 24 storie di incubi e paure (Mondadori, 1977)" ;
    rdamd:P30156 "Horror 24 storie di incubi e paure"@it ;
    rdamd:P30117 "edited by Francesco Franconeri" ;
    rdamd:P30176 "Mondadori" ;
    rdamd:P30011 "1977-04" ;
    rdamd:P30182 "446 p." ;
    rdamd:P30004 "13994",
        "OCLC/WorldCat 799234898",
        "NILF 102022",
        "Goodreads 36147862",
        "Goodreads 35961784" ;
    rdamd:P30106 "Omnibus" ;
    rdamd:P30137 "\"Horror\" subtitled \"24 storie di incubi e paure\" is an original Italian anthology. Contains the following stories, translated by Adriana Dell'Orto, Giulia Fretta and Andrea Terzi:\n• Yours Truly, Jack the Ripper as \"In fede, vostro Jack lo Squartatore\"\n• The Copper Bowl as \"La tazza di rame\"\n• The Hunter as \"Il cacciatore\"\n• Smile Please as \"Per favore, sorridi\"\n• Blood as \"Sangue\"\n• In the X-Ray as \"Nella radiografia\"\n• Strictly for the Birds as \"Riservato ai piccioni\"\n• Vortex of Horror as \"Il vortice dell'orrore\"\n• The Horsehair Truck as \"La valigia di canapa\"\n• A Little Place Off Edgware Road as \"Un cantuccio dalle parti di Edgware Road\"\n• White Caucasian Male as \"Maschio, di razza bianca\"\n• Crescendo as \"Crescendo\"\n• The Green Umbelical Cord as \"Il cordone ombelicale verde\"\n• Graveyard Rats as \"I ratti del cimitero\"\n• The Witch as \"La strega\"\n• The Attic-Express as \"L'attico-express\"\n• The Little Girl Eater as \"L'orco\"\n• \"I passi sulla neve\" is an original Italian shortstory\n• One for My Baby as \"Una per la mia piccola\"\n• The Oldest Story Ever Told as \"La storia più vecchia del mondo\"\n• The Blessington Method as \"Il Metodo Blessington\"\n• The Dead Astronaut as \"L'astronauta morto\"\n• The Shape of Things as \"La forma delle cose\"\n• Contents of Dead Man's Pockets, as \"Il contenuto delle tasche del morto\"\nData from http://www.fantascienza.com\nCatalog number from http://www.catalogovegetti.com" ;
