man:398282
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/398282",
        "https://www.isfdb.org/cgi-bin/pl.cgi?398282" ;
    rdfs:label "Nuove avventure nell'ignoto (Mondadori, 2001)" ;
    rdamd:P30156 "Nuove avventure nell'ignoto"@it ;
