man:367175
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/367175",
        "https://www.isfdb.org/cgi-bin/pl.cgi?367175" ;
    rdfs:label "Vom Leben und Tod Gottes (Heyne, 2007)" ;
    rdamd:P30156 "Vom Leben und Tod Gottes"@de ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "Heyne" ;
    rdamd:P30011 "2007-09" ;
    rdamd:P30182 "[1]+1131 p." ;
    rdamd:P30004 "ISBN 9783453522770",
        "OCLC/WorldCat 220204301" ;
    rdamd:P30106 "Heyne Meisterwerke der Science Fiction" ;
    rdamd:P30137 "Completely revised reissue (\"Vollständig überarbeitete Neuausgabe\") stated on title page.\nFirst printing of this edition (stated on back as separate barcode and number \"01\" next to ISBN barcode).\nStories translated by Charlotte Franke, Joachim Körber, Franz Rottensteiner, Alfred Scholz, Michael Walter and Carl Weissner. Translations revised by Angela Herrmann and Hannes Riffel.\n\"Die Gioconda des Mittagszwielichts\" misprinted as \"Die Giaconda des Mittagszwielichts\" in table of contents but correctly at begin of the story.\nContains a full-page print of the small cover image on page [1].\n\"Gesammelte Erzählungen in zwei Bänden\" printed on title page (collected stories in two volumes).\nEditor: Sascha Mamczak.\nMonth of publication derived from the distribution date stated at amazon.de, which is stated there as 2007-08-06 (as of 2014-09-05).\nSome online resources state that the book contains a foreword (\"Vorwort\") by Christopher Priest, which is not correct." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:1127 ;
