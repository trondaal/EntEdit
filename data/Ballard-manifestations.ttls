        "https://www.isfdb.org/cgi-bin/pl.cgi?378088" ;
    rdfs:label "Visum für die Ewigkeit (Droemer Knaur, 1982)" ;
    rdamd:P30156 "Visum für die Ewigkeit"@de ;
    rdamd:P30117 "edited by Werner Fuchs" ;
    rdamd:P30176 "Droemer Knaur" ;
    rdamd:P30011 "1982-01" ;
    rdamd:P30182 "191 p." ;
    rdamd:P30004 "ISBN 3426057433",
        "OCLC/WorldCat 213416650",
        "DNB 820429384" ;
    rdamd:P30106 "Knaur Science Fiction & Fantasy" ;
    rdamd:P30014 "5743" ;
    rdamd:P30137 "Stated as first German edition (\"Deutsche Erstausgabe\" on the cover, the title page and on the copyright page), it's in fact the original edition.\nTranslated by Irmhild Hübner (Harness and Tuttle), Sylvia Pukallus (Shirley and Vance), Hans Schütz (Bryant), Johannes Jaspert (van Scyoc) and Joachim Körber (Ballard).\n\"© Droemersche Verlagsanstalt Th. Knaur Nachf. München/Zürich 1982\".\nSeries editor: Werner Fuchs.\nStated first printing (\"1. Auflage\" on the copyright page).\nThe month of publication is stated on the copyright page (\"Printed in Germany (...) 182\").\nThe table of contents is printed on p. 5; the individual sources & copyrights are listed on p. 6.\nThe last page of the final piece of shortfiction (p. 191) is unnumbered.\nThe cover art is credited on the copyright page.\nThere's no credit for the cover design." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:5693 ;
    rdamo:P30139 exp:1392696 {| entedit:valueOrder 0 |},
        exp:1392697 {| entedit:valueOrder 1 |},
        exp:1392698 {| entedit:valueOrder 2 |},
        exp:1392699 {| entedit:valueOrder 3 |},
        exp:1392700 {| entedit:valueOrder 4 |},
        exp:1392701 {| entedit:valueOrder 5 |},
        exp:1392702 {| entedit:valueOrder 6 |},
        exp:1392703 {| entedit:valueOrder 7 |} .

