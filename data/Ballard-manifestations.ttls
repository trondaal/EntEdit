man:375662
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/375662",
        "https://www.isfdb.org/cgi-bin/pl.cgi?375662" ;
    rdfs:label "The World Treasury of Science Fiction (Little, Brown / BOMC)" ;
    rdamd:P30156 "The World Treasury of Science Fiction"@en ;
    rdamd:P30117 "edited by David G. Hartwell" ;
    rdamd:P30176 "Little, Brown / BOMC" ;
    rdamd:P30182 "xix+1083 p." ;
    rdamd:P30137 "Retains \"First Edition\" on copyright page.\nOrange boards and orange binding. The only indication that this is a BOMC edition is the circular stamp/depression on the bottom of the back cover.\nUnlike the first BOMC edition there is no ad on the copyright page and in the barcode block on the back cover is the ISBN-13 of the trade edition: 9780316349413, which would place this printing after 2000; otherwise this volume appears to be identical to the first BOMC edition.\nLocus1 states that this volume became the standard offering to new members.\n\"Jacket design by Steve Snider\" appears above the artist credit for Eggleton, on the inside back cover dustflap." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:30293 ;
