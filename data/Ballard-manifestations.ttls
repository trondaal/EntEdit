man:632179
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/632179",
        "https://www.isfdb.org/cgi-bin/pl.cgi?632179" ;
    rdfs:label "Die Angst hat tausend Namen (Pabel, 1974)" ;
    rdamd:P30156 "Die Angst hat tausend Namen"@de ;
    rdamd:P30117 "edited by Christopher Evans (I)" ;
    rdamd:P30176 "Pabel" ;
    rdamd:P30011 "1974-04-30" ;
    rdamd:P30182 "143 p." ;
    rdamd:P30004 "VTB08",
        "OCLC/WorldCat 74162782",
        "DNB 740529110" ;
    rdamd:P30106 "Vampir Taschenbuch" ;
    rdamd:P30014 "8" ;
    rdamd:P30137 "Original English title: Mind at Bay. Abridged.\nFirst edition and printing ('Printed in Germany' and 'Deutsche Erstveröffentlichung' stated on the copyright page).\nTranslated by Monika Hahn.\nMonth stated on copyright page (\"April 1974\"). Day deduced from the 4-weekly publication schedule and nos 7 & 8 published in April 1974.\nThe cover artist is not credited, his signature is clearly visible.\nAs usual in this publication series, the cover counts as page 1.\nOther prices: S 21 (Austria), sfr 3.60 (Switzerland), Lire 800 (Italy), F 45 (Belgium, Luxemburg), FF 5.50 (France), Ptas 80 (Spain), hfl 4.00 (Netherlands)." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:25729 ;
    entedit:P03 per:171973 ;
