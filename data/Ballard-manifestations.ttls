man:391735
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/391735",
        "https://www.isfdb.org/cgi-bin/pl.cgi?391735" ;
    rdfs:label "The Drought (Harper Perennial (UK), 2008)" ;
    rdamd:P30156 "The Drought"@en ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "Harper Perennial (UK)" ;
    rdamd:P30011 "2008" ;
    rdamd:P30182 "vi+233+12 p." ;
    rdamd:P30004 "ISBN 9780586089965" ;
    rdamd:P30137 "Retains the ISBN of the Flamingo edition.\n1st printing of the Harper Perennial UK 2008 edition.\nThe two Roman numerical pages 'v' and 'vi' only contain the Contents.\nThis publication has a numerically separate page section at the rear titled \"P.S.\" which contains two essays. Pages listed in brackets in the Contents below are in fact paginated, but bracketed here to separate them from the earlier contents of the book: they appear after the novel, not before.\n'The Ballard Tradition' first appeared in Prospect magazine, 2003.\n'Cataclysms and Dooms' first appeared in The Visual Encyclopedia of Science Fiction, 1977.\nCover design by David Wardle, as credited to designedbydavid.co.uk." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:25722 ;
    rdamo:P30139 exp:186731 {| entedit:valueOrder 0 |},
        exp:1463099 {| entedit:valueOrder 1 |},
        exp:651185 {| entedit:valueOrder 2 |} .

man:391737
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/391737",
        "https://www.isfdb.org/cgi-bin/pl.cgi?391737" ;
    rdfs:label "Crash (Harper Perennial (UK))" ;
    rdamd:P30156 "Crash"@en ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "Harper Perennial (UK)" ;
    rdamd:P30182 "185+30 p." ;
    rdamd:P30004 "ISBN 9780007287024" ;
    rdamd:P30137 "4th printing of the Harper Perennial UK 2008 edition, no publication date specified.\nThis publication has a numerically separate page section at the rear titled \"P.S.\" which contains six essays. Pages listed in brackets in the Contents below are in fact paginated, but bracketed here to separate them from the earlier contents of the book: they appear after the novel, not before.\nThe 5 essays not attributed to Ballard are credited to Travis Elborough on the copyright page, © 2008.\n'Autopia' first appeared in Drive, 1971.\nCover design by David Wardle, as credited to designedbydavid.co.uk." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:25722 ;
    rdamo:P30139 <http://viaf.org/viaf/305922109/exp/eng/1020> {| entedit:valueOrder 0 |},
        exp:1463111 {| entedit:valueOrder 1 |},
        exp:1463112 {| entedit:valueOrder 2 |},
        exp:1463113 {| entedit:valueOrder 3 |},
        exp:1463114 {| entedit:valueOrder 4 |},
        exp:1463115 {| entedit:valueOrder 5 |},
        exp:1463116 {| entedit:valueOrder 6 |},
        exp:1061891 {| entedit:valueOrder 7 |} .

man:392926
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/392926",
        "https://www.isfdb.org/cgi-bin/pl.cgi?392926" ;
    rdfs:label "Urania, #1450 Supplement (Mondadori, 2002)" ;
    rdamd:P30156 "Urania, #1450 Supplement"@it ;
    rdamd:P30117 "edited by Giuseppe Lippi" ;
    rdamd:P30176 "Mondadori" ;
    rdamd:P30011 "2002-10-06" ;
    rdamd:P30182 "382 p." ;
    rdamd:P30004 "1450 Supplement" ;
    rdamd:P30137 "\"Cinquant'anni di futuro\" is an original Italian anthology, commemorating the 50th year of publication of Urania Magazine. Contains:\nThe Gernsback Continuum translated by Delio Zinoni as \"Il continuum di Gernsback\"\n\"O Gorica, tu sei maledetta\" is an original Italian shortstory\nFranchise translated by Riccardo Valla as \"Diritto di voto\"\nBillennium translated by Beata Della Frattina as \"C'è posto per tutti\"\nDeep End translated by Stefano Torossi as \"L'ultima pozzanghera\"\nInto the Comet translated by Beata Della Frattina as \"Seguendo la cometa\"\nOne of Her Paths translated by Piero Anselmi as \"Uno dei suoi sentieri\"\nBorder Guards translated by Roberto Marini as \"Guardie di confine\"\nHerovit's World translated by Giuseppe Lippi as \"Il mondo di Herovit\"\n\"Cinquant'anni in flashback\" is an original Italian essay\n\"Memory Report\" is an original Italian essay\n\"Due marziani in cattedra ovvero Gli anni di Fruttero e Lucentini\" is an original Italian essay\n\"La suola e la tomaia\" is an original Italian essay\n\"Ricordi dalla redazione\" is an original Italian essay\n\"Cinquant'anni di 'Urania'? Facciamo cento!\" is an original Italian essay\n\"Franco Lucentini da Borges a 'Urania'\" is an original Italian essay\nSupplement to Urania #1450; cover reports also '12' as 12th supplement\nData from http://www.fantascienza.com" ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:4472 ;
