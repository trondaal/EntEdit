man:299573
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/299573",
        "https://www.isfdb.org/cgi-bin/pl.cgi?299573" ;
    rdfs:label "Urania, #482 (Mondadori, 1968)" ;
