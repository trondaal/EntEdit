man:632364
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/632364",
        "https://www.isfdb.org/cgi-bin/pl.cgi?632364" ;
    rdfs:label "7 x Schüttelfrost (Pabel, 1974)" ;
    rdamd:P30156 "7 x Schüttelfrost"@de ;
    rdamd:P30117 "edited by Christopher Evans (I)" ;
    rdamd:P30176 "Pabel" ;
    rdamd:P30011 "1974-06-25" ;
