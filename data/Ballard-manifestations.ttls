    rdamd:P30004 "VTB10",
        "OCLC/WorldCat 74157771",
        "DNB 20025393X",
        "DNB 740492187" ;
    rdamd:P30106 "Vampir Taschenbuch" ;
    rdamd:P30014 "10" ;
    rdamd:P30137 "Original English title: Mind in Chains. Abridged.\nTranslated by Birgit Ress-Bohusch.\nFirst edition and printing (Deutsche Erstveröffentlichung stated on the copyright page).\nMonth stated on copyright page (\"Juni 1974\"). Day deduced from the 4-weekly publication schedule.\nThe cover artist is not credited, there is no visible signature.\nAs usual in this publication series, the cover counts as page 1. The last page is not numbered.\nOther prices: S 21 (Austria), sfr 3.60 (Switzerland), Lire 800 (Italy), F 45 (Belgium, Luxemburg), FF 5.50 (France), Ptas 80 (Spain), hfl 4.00 (Netherlands)." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:25729 ;
