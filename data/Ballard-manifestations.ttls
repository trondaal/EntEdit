man:398010
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/398010",
        "https://www.isfdb.org/cgi-bin/pl.cgi?398010" ;
    rdfs:label "La macchina che uccide (Mondadori, 1998)" ;
    rdamd:P30156 "La macchina che uccide"@it ;
    rdamd:P30117 "edited by Ric Alexander" ;
    rdamd:P30176 "Mondadori" ;
    rdamd:P30011 "1998-12-15" ;
    rdamd:P30182 "352 p." ;
    rdamd:P30106 "Millemondi (quarterly)" ;
    rdamd:P30014 "18" ;
    rdamd:P30137 "Cyber-Killers was translated as \"La macchina che uccide\". Contains:\nBlood Music translated by Delio Zinoni as \"La musica del sangue\"\nSam Hall translated by Delio Zinoni\nBlood Sisters translated by Delio Zinoni as \"Sorelle di sangue\"\nCrime on Mars translated by Delio Zinoni as \"Crimine su Marte\"\nThe Pardoner's Tale translated by Delio Zinoni as \"Il racconto del venditore di indulgenze\"\nA Gift from the Culture translated by Delio Zinoni as \"Un dono dalla Cultura\"\nMurder Will In translated by Delio Zinoni as \"Assassinio mentale\"\nThe Undercity translated by Delio Zinoni as \"Sotto la città\"\nImpostor translated by Vittorio Curtoni as \"Impostore\"\nComfort Me, My Robot translated by Delio Zinoni as \"Conforto di robot\"\nWatch Bird translated by Roberto Marini as \"Uccello da guardia\"\nFrom Fanaticism, Or for Reward translated by Delio Zinoni as \"Per fanatismo, o per soldi\"\nA Kind of Murder translated by Delio Zinoni as \"Nuovi omicidi\"\nZone of Terror translated by Stefano Torossi as \"Zona di terrore\"\nAngel translated by Delio Zinoni as \"Angelo\"\nDreamers translated by Delio Zinoni as \"Sognatori\"\nVirtually Lucid Lucy translated by Delio Zinoni as \"Virtualmente Lucida Lucy\"\nVirtually Alive translated by Delio Zinoni as \"Vita virtuale\"\n# ifdefDEBUG + \"world/enough\" + \"time\", Fondly Fahrenheit, Home is the Hangman, Adventure of the Metal Murderer, Tricentennial and Johnny Mnemonic from the original anthology are missing.\nData from http://www.fantascienza.com\n\"Millemondi Inverno 1998\" on cover page." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:4472 ;
