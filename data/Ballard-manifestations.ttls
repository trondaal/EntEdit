man:444901
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/444901",
        "https://www.isfdb.org/cgi-bin/pl.cgi?444901" ;
    rdfs:label "Der Sturm aus dem Nichts (Heyne, 1969)" ;
    rdamd:P30156 "Der Sturm aus dem Nichts"@de ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "Heyne" ;
    rdamd:P30011 "1969-08" ;
    rdamd:P30182 "155 p." ;
    rdamd:P30004 "3158",
        "OCLC/WorldCat 163759012",
        "DNB 455603782" ;
    rdamd:P30106 "Heyne Science Fiction & Fantasy" ;
    rdamd:P30014 "3158" ;
    rdamd:P30137 "Reprint of the 1964 edition under a new catalog number; so it's technically a new edition.\nTranslated by Gisela Stege.\nApparent first printing.\nMonth of publication from the editor's statement in Terra Nova 78 (preview of Heyne paperbacks).\nThe last page of the novel (p. 155) is unnumbered.\nThe cover is credited to \"Atelier Heinrichs & Bachmann\", the juristical follower of the original 'artist'.\nThe price was taken from DNB." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:1127 ;
    rdamo:P30139 exp:1376678 .

