man:666719
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/666719",
        "https://www.isfdb.org/cgi-bin/pl.cgi?666719" ;
    rdfs:label "Vorposten im All (Pabel, 1964)" ;
    rdamd:P30156 "Vorposten im All"@de ;
    rdamd:P30117 "Wallace West" ;
    rdamd:P30176 "Pabel" ;
    rdamd:P30011 "1964-09-01" ;
    rdamd:P30182 "60 p." ;
    rdamd:P30004 "UZ401",
        "OCLC/WorldCat 73753429",
        "DNB 455199280" ;
    rdamd:P30106 "Utopia Zukunftsroman" ;
    rdamd:P30014 "401" ;
    rdamd:P30137 "First German edition and printing (not explicitly stated). Most likely abridged.\nThe publication presents itself as a novel, so there are no story titles given.\nTranslated by uncredited.\nThe publication date is deduced from the fortnightly publication schedule.\nPp. 59 - 63 have part 1 of a (serialised) story by J. G. Ballard.\nThe cover art is not credited. Although Lonati is credited at rs-lonati.de, the true artist is Gerhard Görner. Comicartfans notes Gerhard Görner's stamp and signature on the back of the original art; attributions by other internet sources to R. S. Lonati are wrong.\nOther price: S 4 (Austria), L 140 (Italy), sfr 0.80 (Switzerland), NF 1.00 (France), lfr 9.50 (Luxemburg), DM 0.60 (special price for Berlin)." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:25729 ;
    rdamo:P30139 exp:2373191 {| entedit:valueOrder 0 |},
        exp:2552538 {| entedit:valueOrder 1 |},
        exp:2552537 {| entedit:valueOrder 2 |},
        exp:2552536 {| entedit:valueOrder 3 |},
        exp:2552535 {| entedit:valueOrder 4 |},
        exp:2552534 {| entedit:valueOrder 5 |} .

