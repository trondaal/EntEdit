man:287983
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/287983",
        "https://www.isfdb.org/cgi-bin/pl.cgi?287983" ;
    rdfs:label "The World Treasury of Science Fiction (Little, Brown / QPBC, 1989)" ;
    rdamd:P30156 "The World Treasury of Science Fiction"@en ;
    rdamd:P30117 "edited by David G. Hartwell" ;
    rdamd:P30176 "Little, Brown / QPBC" ;
    rdamd:P30011 "1989-06" ;
    rdamd:P30182 "xix+1083 p." ;
    rdamd:P30004 "LCCN 88-82960",
        "OCLC/WorldCat 423753294" ;
    rdamd:P30137 "First Edition on copyright page. [This Publication Record].\nNo printing, printing date or pricing on/in book. Dating from LOCUS 1.\nCopyright © 1989 by David G. Hartwell.\nIntroduction copyright © 1989 by Clifton Fadiman.\n\"BOMC\" only indicated by ad on copyright page for other media types availability.\nQPBC from Locus1.\nThis is identical to the hardcover edition except it lacks an ISBN and has the dust jacket printed as the cover.\nCover artist not credited in book. Signature not found. Artist verified from hc edition credits.\n\"Acknowledgments of permission to reprint previously copyrighted material appear on pages 1079-1083.\" on copyright page.\nPublished simultaneously in Canada.\nPrinted in the United States of America.\n\"Edited by David G. Hartwell\" on title page.\n\"with a Foreword by Clifton Fadiman, General Editor.\" on title page.\nForeword ends with Clifton Fadiman (over) General Editor.\nWeihnachtsabend is given on story title page as \"Weihnact-sabend\" with all after the hyphen below. Apparently a word break to allow the spacing used with the title font." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:30973 ;
    entedit:P03 <http://viaf.org/viaf/33278380> ;
