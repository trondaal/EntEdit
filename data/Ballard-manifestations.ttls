man:1068618
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/1068618",
        "https://www.isfdb.org/cgi-bin/pl.cgi?1068618" ;
    rdfs:label "I mondi del possibile: il meglio della fantascienza 1956-1965 (Fanucci Editore, 1983)" ;
    rdamd:P30156 "I mondi del possibile: il meglio della fantascienza 1956-1965"@it ;
    rdamd:P30117 "edited by Michael Ashley ; Gianni Pilo" ;
    rdamd:P30176 "Fanucci Editore" ;
    rdamd:P30011 "1983-05" ;
    rdamd:P30182 "414 p." ;
    rdamd:P30004 "OCLC/WorldCat 797392918",
        "NILF 103808" ;
    rdamd:P30106 "Enciclopedia della fantascienza" ;
    rdamd:P30014 "10" ;
    rdamd:P30137 "Only Ashley credited as editor of the anthology on the title page; Pilo is credited as editor of the series.\nCopyright page states: 1st edition May 1983; integral translation (Translated by Roberta Rambelli).\nFrom the colophon: print date Jul 1983.\nThe uncredited introduction is an excerpt from the introduction by Gianfranco de Turris & Sebastiano Fusco present in the first books of this series; it is the part describing the generic structure of the volumes in the series, which is however no longer applied. The introduction signed by Pilo is printed as a continuation of the first.\nAshley's part is a section titled L'era del riflusso (1956-1965).\nOn p. 10, the copyrights of the translated stories.\nAshley's introduction is dated February 1976.\nEach story has a header containing the year and magazine name, and is preceded by a presentation.\nPilo's part is a section titled Le riviste italiane (1957-1982).\nCover art not credited in the book, found at gutenberg.org." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:1726 ;
    entedit:P03 per:1367 ;
    entedit:P07 per:1367 ;
