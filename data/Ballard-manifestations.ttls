man:1041883
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/1041883",
        "https://www.isfdb.org/cgi-bin/pl.cgi?1041883" ;
    rdfs:label "L'ora di fantascienza (Einaudi, 1982)" ;
    rdamd:P30156 "L'ora di fantascienza"@it ;
    rdamd:P30117 "edited by Carlo Fruttero ; Franco Lucentini" ;
    rdamd:P30176 "Einaudi" ;
    rdamd:P30011 "1982-01-16" ;
    rdamd:P30182 "ix+312 p." ;
    rdamd:P30004 "5343-9",
        "OCLC/WorldCat 797528892",
        "NILF 103382",
        "ASIN B005LO4K74",
        "ASIN B00V37LW1K" ;
    rdamd:P30106 "Letture per la scuola media" ;
    rdamd:P30014 "64" ;
    rdamd:P30137 "No ISBN in the book; OPAC-SBN records 88-06-53439-4 and 88-286-0036-5, perhaps from later reprints.\nNo printing indication, most likely the first; date from the colophon.\nThe book is divided into 4 sections, titled I nostri dissimili (p. 3, 7 stories), Nuove vie delle Indie (p. 85, 8 stories), Ritorno a Pitagora (p.201, 4 stories), Il futuro alla gola (p. 239, 5 stories). Each section begins and ends with two short, untitled introductions by the editors (one for the subject of the section and one for the authors).\nEach story is preceded by a very short presentation by the editors.\nThe cover is an illustration, titled Grandes manœuvres - surprise du port de Brest par les goubets, from chapter 7 of Robida's novel La vie électrique (1890)." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:29271 ;
