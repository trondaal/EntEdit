man:443880
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/443880",
        "https://www.isfdb.org/cgi-bin/pl.cgi?443880" ;
    rdfs:label "Karneval der Alligatoren (Heyne, 1972)" ;
    rdamd:P30156 "Karneval der Alligatoren"@de ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "Heyne" ;
    rdamd:P30011 "1972-09" ;
    rdamd:P30182 "144 p." ;
    rdamd:P30004 "3308",
        "DNB 730163938" ;
    rdamd:P30106 "Heyne Science Fiction & Fantasy" ;
    rdamd:P30014 "3308" ;
    rdamd:P30137 "First German mass-market paperback edition.\nTranslated by Inge Wiskott.\nStated as a license of the publishing house Marion von Schröder.\nJudging from the standardized and reduced page count, this edition was possibly abridged.\nApparent first printing.\n\"Printed in Germany 1972\" stated on copyright page.\nEditor: Günter M. Schelwokat.\nMonth of publication from the schedule for Heyne Science Fiction & Fantasy in 1972 (four books per month).\nThe last page of the novel (p. 144) is unnumbered.\nThe cover art is credited on the copyright page.\nThe cover design (\"Umschlaggestaltung\") is credited to Atelier Heinrichs.\nFeatures an uncredited photo of the author on the back cover.\nPrice from Deutsche Nationalbibliothek." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:1127 ;
    rdamo:P30139 exp:1373219 .

