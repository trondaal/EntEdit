man:402258
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/402258",
        "https://www.isfdb.org/cgi-bin/pl.cgi?402258" ;
    rdfs:label "La mostra delle atrocità (Bompiani, 1995)" ;
    rdamd:P30156 "La mostra delle atrocità"@it ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "Bompiani" ;
    rdamd:P30011 "1995-04" ;
    rdamd:P30182 "vi+272 p." ;
    rdamd:P30004 "ISBN 8845224376" ;
    rdamd:P30106 "Gli Squali" ;
    rdamd:P30014 "1" ;
    rdamd:P30137 "The Atrocity Exhibition was translated by Antonio Caronia as \"La mostra delle atrocità\". Single stories were translated as follows:\nThe Atrocity Exhibition as \"La mostra delle atrocità\"\nThe University of Death as \"L'università della morte\"\nThe Assassination Weapon as \"L'arma omicida\"\nYou: Coma: Marilyn Monroe as \"Tu:Coma:Marilyn Monroe\"\nNotes Toward a Mental Breakdown as \"Appunti per un collasso mentale\"\nThe Great American Nude as \"Il grande nudo americano\"\nThe Summer Cannibals as \"Cannibali d'estate\"\nTolerances of the Human Face as \"Tolleranza del viso umano\"\nYou and Me and the Continuum as \"Tu e io e il continuum\"\nPlan for the Assassination of Jacqueline Kennedy as \"Piano per l'assassinio di Jacqueline Kennedy\"\nLove and Napalm: Export USA as \"Amore e napalm: gli USA formato esportazione\"\nCrash! as \"Crash\"\nThe Generations of America as \"Le generazioni dell'America\"\nWhy I Want to Fuck Ronald Reagan as \"Ecco perché voglio fottere Reagan\"\nThe Assassination of John Fitzgerald Kennedy Considered as a Downhill Motor Race as \"L'assassinio di John Fitzgerald Kennedy considerato come una gara automobilistica in discesa\"\nPrincess Margaret's Facelift as \"Il lifting della principessa Margaret\"\nMae West's Reduction Mammoplasty as \"La plastica mammaria riduttiva di Mae West\"\nQueen Elizabeth's Rhinoplasty as \"La rinoplastica della regina Elisabetta\"\nSecret History of World War 3 as \"Storia segreta della Terza guerra mondiale\"\nData from http://www.fantascienza.com" ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:1949 ;
