man:414143
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/414143",
        "https://www.isfdb.org/cgi-bin/pl.cgi?414143" ;
    rdfs:label "Le grandi storie della fantascienza: 1960 (Mondadori, 1992)" ;
    rdamd:P30156 "Le grandi storie della fantascienza: 1960"@it ;
    rdamd:P30117 "edited by Isaac Asimov ; Martin H. Greenberg" ;
    rdamd:P30176 "Mondadori" ;
    rdamd:P30011 "1992-12" ;
    rdamd:P30182 "320 p." ;
    rdamd:P30004 "ISBN 8804361026" ;
    rdamd:P30106 "I Libri di Urania" ;
    rdamd:P30014 "1" ;
    rdamd:P30137 "Isaac Asimov Presents the Great Sf Stories 22 was translated by varî as \"Le grandi storie della fantascienza: 1960\". Single stories were translated as follows:\n• Mariana translated by Lydia Di Marco as \"Mariana\"\n• The Day the Icicle Work Closed translated by Antonella Pieretti as \"Il giorno in cui la fabbrica di ghiaccioli chiuse i battenti\"\n• The Fellow Who Married the Maxill translated by Antonella Pieretti as \"Quello che sposò la figlia di Maxill\"\n• Mine Own Ways translated by Antonella Pieretti as \"Il mio modo di fare\"\n• Make Mine... Homogenized translated by Antonella Pieretti as \"I miei... omogeneizzati\"\n• The Lady Who Sailed the \"Soul\" translated by Antonella Pieretti as \"La donna che pilotò The Soul\"\n• I Remember Babylon translated by Antonella Pieretti as \"Ricordo Babilonia\"\n• Chief translated by Antonella Pieretti as \"Capo\"\n• Mind Partner translated by Antonella Pieretti as \"Compagno mentale\"\n• The Handler translated by Lydia Di Marco as \"Il manipolatore\"\n• The Voices of Time translated by Abramo Luraschi as \"Le voci del tempo\"\nData from http://www.fantascienza.com, which reports Chiconi as cover artist, but the cover is that of Classici Urania #181, credited to Eggleton.\nISBN verified on Amazon IT." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:4472 ;
