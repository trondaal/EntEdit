man:383519
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/383519",
        "https://www.isfdb.org/cgi-bin/pl.cgi?383519" ;
    rdfs:label "Urania, #908 (Mondadori, 1981)" ;
    rdamd:P30156 "Urania, #908"@it ;
    rdamd:P30117 "edited by Carlo Fruttero ; Franco Lucentini" ;
    rdamd:P30176 "Mondadori" ;
    rdamd:P30011 "1981-12-26" ;
    rdamd:P30182 "384 p." ;
    rdamd:P30004 "908" ;
    rdamd:P30137 "\"Ultime notizie dall'America Ora zero\" contains Hello America translated by Marco and Dida Paggi as \"Ultime notizie dall'America\" and The Venus Hunters translated as \"Ora zero\". Single stories were translated as follow:\nNow: Zero translated by Laura Serra as \"Ora zero\"\nThe Time Tombs translated by Laura Serra as \"I saccheggiatori di tombe\"\nTrack 12 translated by Hilia Brinis as \"Amplificazione\"\nPassport to Eternity translated by Hilia Brinis as \"Passaporto per l'eternità\"\nEscapement translated by Hilia Brinis as \"Il tempo si guasta\"\nTime of Passage translated by Hilia Brinis as \"Controtempo\"\nThe Venus Hunter translated by Laura Serra as \"UFO da Venere\"\nThe Recognition translated by Laura Serra as \"Mattatoio\" (not present in the original collection)\nOne Afternoon at Utah Beach translated by Laura Serra as \"Un pomeriggio a Utah Beach\"\nThe 60 Minute Zoom translated by Laura Serra as \"Zoom di 60 minuti\"\nThe Killing Ground from the original collection is missing." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:4472 ;
    rdamo:P30363 per:5902,
        per:2203 ;
