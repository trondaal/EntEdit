man:242181
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/242181",
        "https://www.isfdb.org/cgi-bin/pl.cgi?242181" ;
    rdfs:label "The Second IF Reader of Science Fiction (Sphere, 1971)" ;
