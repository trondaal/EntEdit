man:380217
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/380217",
        "https://www.isfdb.org/cgi-bin/pl.cgi?380217" ;
    rdfs:label "Urania, #764 (Mondadori, 1978)" ;
    rdamd:P30156 "Urania, #764"@it ;
    rdamd:P30117 "edited by Carlo Fruttero ; Franco Lucentini" ;
    rdamd:P30176 "Mondadori" ;
    rdamd:P30011 "1978-12-17" ;
    rdamd:P30182 "192 p." ;
    rdamd:P30004 "764" ;
    rdamd:P30137 "The Terminal Beach was translated by Beata Della Frattina as \"Il gigante annegato\". Single stories were translated as follow:\nA Question of Re-Entry as \"L'astronauta scomparso\"\nThe Drowned Giant as \"Il gigante annegato\"\nEnd-game as \"L'ultima mossa\"\nThe Crystal World as \"L'uomo luminoso\"\nThe Reptile Enclosure as \"La spiaggia\"\nThe Delta at Sunset as \"Il delta al tramonto\"\nThe Terminal Beach as \"Terminal\"\nDeep End as \"L'ultima pozzanghera\". Although credited to Beata Della Frattinas, this translation is word-by-word nearly identical to the one in Urania # 321, credited to Stefano Torossi.\nThe Volcano Dances as \"Le danze sul vulcano\"\nBillennium as \"Per piccina che...\"\nThe Gioconda of the Twilight Noon as \"La Gioconda del crepuscolo di mezzogiorno\"\nThe Lost Leonard as \"Il Leonardo scomparso\"\nData from http://www.fantascienza.com" ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:4472 ;
    rdamo:P30363 per:5902,
        per:2203 ;
