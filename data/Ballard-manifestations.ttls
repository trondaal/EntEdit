man:398046
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/398046",
        "https://www.isfdb.org/cgi-bin/pl.cgi?398046" ;
    rdfs:label "Phantastische Zeiten (Suhrkamp, 1986)" ;
    rdamd:P30156 "Phantastische Zeiten"@de ;
    rdamd:P30117 "edited by Franz Rottensteiner" ;
