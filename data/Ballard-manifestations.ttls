    rdamd:P30156 "The Day of Creation"@en ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "Lester & Orpen Dennys" ;
    rdamd:P30011 "1987" ;
    rdamd:P30182 "254 p." ;
    rdamd:P30004 "ISBN 0886191815",
        "OCLC/WorldCat 16578839" ;
    rdamd:P30137 "\"FIRST EDITION\" stated on the copyright page.\nThe copyright page prints the Canadian Cataloguing in Publication Data including the year of publication (1987), ISBNs of both this hardcover edition (0-88619-181-5) and the paperback edition (0-88619-183-1), and the Canadiana catalog number: C87-094495-9.\nNo printed price. Price is from the Library and Archives Canada website.\nPublished in Canada, but printed and bound in the United Kingdom.\n\"Jacket illustration by Paul Wright\" printed on the back flap of the dustjacket." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:25597 ;
    rdamo:P30139 <http://viaf.org/viaf/308025936/exp/eng/1020> .

