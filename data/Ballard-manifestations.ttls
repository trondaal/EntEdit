man:37706
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/37706",
        "https://www.isfdb.org/cgi-bin/pl.cgi?37706" ;
    rdfs:label "The Crystal World (The Easton Press, 1991)" ;
    rdamd:P30156 "The Crystal World"@en ;
    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "The Easton Press" ;
    rdamd:P30011 "1991" ;
    rdamd:P30182 "x+210 p." ;
    rdamd:P30106 "The Masterpieces of Science Fiction" ;
    rdamd:P30137 "\"COLLECTOR'S EDITION\" (over) \"Bound in Genuine Leather\" stated on the title page.\n\"The special contents of this edition are copyright © 1991 by The Easton Press...\" stated on the copyright page. No stated date of publication.\nThis is a limited edition of an unknown number of copies and was available by subscription only.\nOne of The Masterpieces of Science Fiction series, indicated by the logo printed on the endpapers.\nNo ISBN, no printed price, and no dustjacket as issued.\nThe uncredited illustrative cover design is repeated on the back.\nPages are gilt-edged and there is a navy blue satin bookmark bound into the book.\nThe frontispiece, credited on the title page and the copyright page, is on the page facing the title page.\n\"Collector's Notes\" (uncredited) are on a double-sided laid-in sheet.\nThis edition is a facsimile reprint of the 1966 Farrar edition.\nLocus1 dates this as May, 1991, but this can't be confirmed because of the difficulty in determining the publication dates of Easton Press editions.\nVerified copy was purchased for approximately $40.00 from the publisher." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:56 ;
    entedit:P03 <http://viaf.org/viaf/103212466> ;
    rdamo:P30139 exp:3570 {| entedit:valueOrder 0 |},
        exp:796249 {| entedit:valueOrder 1 |} .

