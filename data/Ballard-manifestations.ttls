man:293929
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/293929",
        "https://www.isfdb.org/cgi-bin/pl.cgi?293929" ;
    rdfs:label "Foundation, #10 June 1976 (North East London Polytechnic, 1976)" ;
    rdamd:P30156 "Foundation, #10 June 1976"@en ;
    rdamd:P30117 "edited by Peter Nicholls ; Ian Watson ; Christopher Priest" ;
    rdamd:P30176 "North East London Polytechnic" ;
    rdamd:P30011 "1976-06" ;
    rdamd:P30182 "132 p." ;
    rdamd:P30137 "Publisher stated as 'North East London Polytechnic on behalf of the Science Fiction Foundation' on the copyright page.\nThe subscription price for an individual is stated as £2.55 in the UK & Europe and $7.50 in the USA and Canada via surface mail ($12 via air mail).\nPage numbering starts on the first interior (third) page. The last numbered page is 129 (followed only by the back cover).\nContents on pp. 1ff.\nIan Watson edited the Features (pp. 6-44), Christopher Priest the items for Foundation Forum (pp. 55-77): the essays for these sections are shortly introduced.\nBallard's letters are printed in reverse chronological order at his request.\nThe reviews are titled (apparently by Nicholls, not by the reviewers)." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
