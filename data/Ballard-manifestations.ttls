man:1094103
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/1094103",
        "https://www.isfdb.org/cgi-bin/pl.cgi?1094103" ;
    rdfs:label "The Visual Encyclopedia of Science Fiction (Book Club Associates, 1978)" ;
    rdamd:P30156 "The Visual Encyclopedia of Science Fiction"@en ;
    rdamd:P30117 "Brian Ash" ;
    rdamd:P30176 "Book Club Associates" ;
    rdamd:P30011 "1978" ;
    rdamd:P30182 "352 p." ;
    rdamd:P30004 "CN2293" ;
    rdamd:P30137 "States this edition published 1978 by Book Club associates by arrangement\nCatalogue number CN 2293 on rear dust jacket flap\n01 Program [Pages 9 - 66] (A timeline of magazine dates, magazine stories, books, films/television/radio, and fandom)\n02 Thematics [Pages 67 - 246] (Separate sections listed below with introductions by the authors indicated; the main body of each article is uncredited, presumably written by Brian Ash)\n03 Deep Probes [Pages 247- 270] (Articles listed below)\n04 Fandom and Media [Pages 271 - 342] (Ten uncredited articles on fandom, science fiction art, science fiction in the cinema, science fiction on television, science fiction magazines, books and anthologies, juveniles (including comics and strips), commentators and course, and fringe cults (including sub-articles on Charles Fort, Richard S. Shaver and L. Ron Hubbard)" ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:29447 ;
