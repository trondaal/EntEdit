man:541294
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/541294",
        "https://www.isfdb.org/cgi-bin/pl.cgi?541294" ;
    rdfs:label "Science Fiction Jubiläums Band: 25 Jahre Heyne Science Fiction & Fantasy, 1960-1985 (Heyne, 1985)" ;
    rdamd:P30156 "Science Fiction Jubiläums Band: 25 Jahre Heyne Science Fiction & Fantasy, 1960-1985"@de ;
    rdamd:P30117 "edited by Wolfgang Jeschke" ;
