man:377893
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/377893",
        "https://www.isfdb.org/cgi-bin/pl.cgi?377893" ;
    rdfs:label "The Visual Encyclopedia of Science Fiction (Harmony Books, 1977)" ;
    rdamd:P30156 "The Visual Encyclopedia of Science Fiction"@en ;
    rdamd:P30117 "Brian Ash" ;
    rdamd:P30176 "Harmony Books" ;
    rdamd:P30011 "1977" ;
    rdamd:P30182 "352 p." ;
    rdamd:P30004 "ISBN 0517531747" ;
    rdamd:P30137 "US hardcover edition, published simultaneously in trade paperback.\nBook Sections:\n01 Program [Pages 9 - 66] (A timeline of magazine dates, magazine stories, books, films/television/radio, and fandom)\n02 Thematics [Pages 67 - 246] (Separate sections listed below with introductions by the authors indicated; the main body of each article is uncredited, presumably written by Brian Ash)\n03 Deep Probes [Pages 247- 270] (Articles listed below)\n04 Fandom and Media [Pages 271 - 342] (Ten uncredited articles on fandom, science fiction art, science fiction in the cinema, science fiction on television, science fiction magazines, books and anthologies, juveniles (including comics and strips), commentators and course, and fringe cults (including sub-articles on Charles Fort, Richard S. Shaver and L. Ron Hubbard)" ;
    rdamo:P30001 rdact:1049 ;
