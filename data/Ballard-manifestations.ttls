    rdamd:P30117 "J. G. Ballard" ;
    rdamd:P30176 "G. P. Putnam's Sons / SFBC" ;
    rdamd:P30011 "1971-11" ;
    rdamd:P30182 "310 p." ;
    rdamd:P30004 "1213",
        "OCLC/WorldCat 2312683" ;
    rdamd:P30137 "\"Book Club Edition\" printed at the bottom of the front flap of the dustjacket indicates a printing by Doubleday for its various book clubs.\nSelection of the Science Fiction Book Club for November 1971.\nNo printed price, from an unknown source but is consistent with book club editions at the time.\nNo stated date of publication, taken from the listing provided by SFBC editor Andrew Wheeler to the rec.arts.sf.written newsgroup.\n\"1213\" printed at the bottom on the back flap of the dustjacket.\nFirst printing has gutter code \"42M\" [verified] on page 309, indicates a printing in October 1971.\n\"Cover painting by Nicole de Jurenev\" printed on the back flap of the dustjacket." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:16953 ;
