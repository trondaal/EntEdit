    rdamd:P30117 "edited by Thomas M. Disch" ;
    rdamd:P30176 "Bastei Lübbe" ;
    rdamd:P30011 "1981-02" ;
    rdamd:P30182 "368 p." ;
    rdamd:P30004 "ISBN 3404220293",
