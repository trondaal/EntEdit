    rdamd:P30011 "1997-09" ;
    rdamd:P30182 "ii+328+[1] p." ;
    rdamd:P30004 "ISBN 0006550649" ;
    rdamd:P30137 "\"First published in Great Britain by Flamingo 1996\" and \"This paperback edition 1997\" stated on the copyright page (p. 4) with a complete number line: \"9 8 7 6 5 4 3 2 1\".\nTitle page shows the publisher as \"Flamingo (over) An Imprint of HarperCollinsPublishers\".\nISBN on copyright page and back.\nThere are two pages that don't fit into the page count preceding p. 1. These pages are notated here with i-ii.\nContents on pp. v & vi.\nNo credit for cover art/cover design.\nNo statement of the month.\nFeatures a photo of the author credited to Jerry Bauer on inside cover page, a note on Ballard on p. i and citations from reviews of Cocaine Nights on pp. i-1." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:502 ;
    rdamo:P30139 exp:10552 .

