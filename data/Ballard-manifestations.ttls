    rdamd:P30011 "1982-06" ;
    rdamd:P30182 "32 p." ;
    rdamd:P30137 "#2\n\"Edited and produced collectively by John Clute, Alan Dorey, Malcolm Edwards, Colin Greenland, Graham James, Roz Kaveney, Simon Ounsley and David Pringle\" is stated on p. 2, which serves also as contents page.\nNo statement for a publisher to be found.\n\"Interzone is published quarterly, in March, June, September and December\", so this issue should have been published in June of 1982.\nThe Editorial is continued on p. 20.\n\"Designed by Philippa Bramson\".\nP. 32 is an ad page for two books announced for May 27th and June 10th, respectively." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30363 per:719,
        per:10534,
