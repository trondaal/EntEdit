    rdamd:P30011 "1971-02" ;
    rdamd:P30182 "256 p." ;
    rdamd:P30004 "ISBN 0722169221",
        "OCLC/WorldCat 315911090" ;
    rdamd:P30137 "Apparent first printing.\nYou have to get to unnumbered page 9 to find the exact \"The Second IF Reader of Science Fiction\" title page.\nUnnumbered page 5 just has \"The Second 'IF' Reader\" and on unnumbered page 3 it's 'The Second \"IF\" Reader'; fc has \"the second 'if' reader\", and spine \"The Second 'If' Reader\".\nThe multiple title pages seem to have left no room for a contents page, so all entries are taken from the first page for each story. (As ISFDB best practices suggest anyway.) In particular, \"Forest in the Sky\" definitely has no leading \"The\".\nOther prices: A$1.10, NZ$1.10, South Africa 85c, East Africa 8/25." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:49 ;
