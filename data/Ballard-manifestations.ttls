man:8713
    a rdac:C10007 ;
    rdaxd:P00018 "http://entedit.org/manifestation/8713",
        "https://www.isfdb.org/cgi-bin/pl.cgi?8713" ;
    rdfs:label "Dangerous Visions (Doubleday / SFBC, 1967)" ;
    rdamd:P30156 "Dangerous Visions"@en ;
    rdamd:P30117 "edited by Harlan Ellison" ;
    rdamd:P30176 "Doubleday / SFBC" ;
    rdamd:P30011 "1967-12" ;
    rdamd:P30182 "xxix+544 p." ;
    rdamd:P30004 "1179",
        "OCLC/WorldCat 1920045" ;
    rdamd:P30137 "\"Book Club Edition\" printed at the bottom of the front inside flap of the dustjacket indicates a printing by Doubleday for its various book clubs.\nSelection of the Science Fiction Book Club for December 1967.\nNo printed price or stated date of publication. Info given here taken from Tuck.\n\"1179\" printed at the bottom of the back inside flap of the dustjacket. Some later printings placed this number on the back cover of the dustjacket.\nGutter code \"I38\" on page 544 indicates the first SFBC printing in September 1967. Later printings have the gutter codes \"46I\" (1967), \"20K\" (page 539, for May 1969, PV7 copy) \"47K\" (1969), \"34P\" (1974), \"R44\" (1976), \"V1\" (1980) and \"X37\" [verified] (1982) [Image from this printing]\nJacket design by Diane and Leo Dillon." ;
    rdamo:P30001 rdact:1049 ;
    rdamo:P30002 rdamt:1007 ;
    rdamo:P30420 pbl:17013 ;
