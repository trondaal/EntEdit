<http://viaf.org/viaf/5196155286593787180009> a rdac:C10001 ;
    rdfs:label "Now and forever / Ray Bradbury"@en,
        "Now and forever / Ray Bradbury"@no ;
    entedit:P01 <https://schema.nb.no/Bibliographic/Values/V1000> ;
    rdawd:P10223 "Now and forever" ;
    rdawd:P10330 "Presents two novellas, including \"Somewhere a Band Is Playing,\" in which a young writer discovers that all is not as it seems in a nostalgic community, and \"Leviathan '99,\" in which Ishmael Hunnicut Jones prepares for a first interstellar hunt." ;
    rdawo:P10061 <http://viaf.org/viaf/12305881> ;
    rdawo:P10147 <http://viaf.org/viaf/1066162985524886300002>,
        <http://viaf.org/viaf/181334419> ;
    rdaxd:P00018 "http://viaf.org/viaf/5196155286593787180009" .

