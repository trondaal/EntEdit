        "https://www.isfdb.org/cgi-bin/title.cgi?45882" ;
    rdawd:P10223 "Junior"@en ;
    rdfs:label "Junior (Abernathy, Robert)" ;
    rdawd:P10219 "1956-01" ;
    rdawd:P10330 "Aliens who resemble sea anemones discuss their son, who is still carefree and swimming around. They think that it is high time that he finds a nice rock, decorate it so that it would catch a nice girl and settle down on the rock for rest of his life. But he has a plan... He assembles a platform on wheels so that he isn't confined to one place.",
        "First published in Galaxy Science Fiction, January 1956." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:1849 .

