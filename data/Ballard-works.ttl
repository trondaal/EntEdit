<http://viaf.org/viaf/311471559>
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/40816",
        "https://www.isfdb.org/cgi-bin/title.cgi?40816",
        "http://viaf.org/viaf/311471559" ;
    rdawd:P10223 "The Voices of Time"@en ;
    rdfs:label "The Voices of Time (Ballard, J. G.)" ;
    rdawd:P10219 "1960-10" ;
    rdawd:P10330 "In a time not too far from ours, society is winding down as humans are overtaken by narcolepsy and plants and animals are mutating wildly to adapt to the old-age of Life itself, while mysterious signals from space appear to be counting down to the end of their sources, and the Universe itself." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 <http://viaf.org/viaf/9842556> .

