wrk:1758360
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/1758360",
        "https://www.isfdb.org/cgi-bin/title.cgi?1758360" ;
    rdawd:P10223 "仙人"@ja ;
    rdawd:P10086 "Sen'nin" ;
    rdfs:label "仙人 (芥川龍之介)" ;
    rdawd:P10219 "1916-08" ;
    rdawd:P10330 "This story was first published in August 1916 in the Tokyo Imperial University student magazine 新思潮, Shin shichō, \"New trend of thought\". A revised version seems to have been published in 1922.\nThe original Japanese title of this story, 仙人, is transcribed as Sen'nin in the Revised Hepburn notation (a sinicized pronunciation, from Mandarin xiānrén), and means \"hermit\" (also \"wizard; fairy\"). It is composed of 仙, sen, \"hermit; immortal\" (literally, \"man in the mountain\") and 人, usually pronounced hito, \"man\"." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:112179 .

