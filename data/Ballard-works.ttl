wrk:1728484
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/1728484",
        "https://www.isfdb.org/cgi-bin/title.cgi?1728484" ;
    rdawd:P10223 "Le reste est silence"@fr ;
    rdfs:label "Le reste est silence (Sternberg, Jacques)" ;
    rdawd:P10219 "1963-08" ;
    rdawd:P10330 "The narrator develops a relationship with a woman he saw walking into a café. Indifferent to any aspect of life, she seems very rich, and has to travel frequently all over the world. She never speaks much, especially about herself, never asks questions, and reminds him of a panther or some other feline. By looking into a notebook she has left lying around, he discovers that she is indeed Death, but that for some incomprehensible reason, his own death is the only one that is not mentioned in it.\nNote : this story is to be associated with \"Marée basse\", which follows it in the Univers zéro collection, and where a different relationship exists between the narrator and Death." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:3983 .

