wrk:41539
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/41539",
        "https://www.isfdb.org/cgi-bin/title.cgi?41539" ;
    rdawd:P10223 "Come and Go Mad"@en ;
    rdfs:label "Come and Go Mad (Brown, Fredric)" ;
    rdawd:P10219 "1949-07" ;
    rdawd:P10330 "Journalist George Vine claims having lost all memory previous to a car accident three years ago. Yet, he clearly remembers having been Napoleon Bonaparte until he fell asleep in his tent after the battle of Lodi. When his boss suggests he investigates a certain matter in a psychiatric hospital, he has no difficulty in finding a good motive to be admitted inside. The question is: is he really suffering from paranoia? Or is it something else?" ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:10 .

