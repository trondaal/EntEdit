wrk:3514265
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/3514265",
        "https://www.isfdb.org/cgi-bin/title.cgi?3514265" ;
    rdawd:P10223 "Нартски митове"@bg ;
    rdawd:P10086 "Nartski mitove" ;
    rdfs:label "Нартски митове" ;
    rdawd:P10219 "1995" ;
    rdawd:P10330 "Translated by Соня Бояджиева (Sonya Boyadzhieva)\nMost likely a translation from Russian. Original title and language unknown.\nThe title translates as \"The myths of Nart\"\nThe Nart sagas are a series of stories originating from the North Caucasus. More details are available here. The translated stories here are part of the story of Batraz." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 .

wrk:3514266
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/3514266",
        "https://www.isfdb.org/cgi-bin/title.cgi?3514266" ;
    rdawd:P10223 "Изилакулуна, на когото половината тяло било дървено"@bg ;
    rdawd:P10086 "Izilakuluna, na kogoto polovinata tyalo bilo darveno" ;
    rdfs:label "Изилакулуна, на когото половината тяло било дървено" ;
    rdawd:P10219 "1995" ;
    rdawd:P10330 "Translated by Соня Бояджиева (Sonya Boyadzhieva)\nMost likely a translation from Russian FantLab title 893631 (\"Изилакулуна, у которого половина тела была деревянной\") which itself is a translation from French of the original Malagasy traditional story.\nThe title translates as \"Izilakuluna, who has half a body made of wood\"" ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 .

wrk:3514267
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/3514267",
        "https://www.isfdb.org/cgi-bin/title.cgi?3514267" ;
    rdawd:P10223 "Как се появил духът Феху—Луни"@bg ;
    rdawd:P10086 "Kak se poyavil duhat Fehu-Luni" ;
    rdfs:label "Как се появил духът Феху—Луни" ;
    rdawd:P10219 "1995" ;
    rdawd:P10330 "Translated by Соня Бояджиева (Sonya Boyadzhieva)\nProbably translated from Russian (FantLab title 1609471 (\"Происхождение духа Феху-луни\"). The original language is unknown but Fehu-Luni (usually spelled Fehuluni or Felehuhuni) is part of Tongan mythology and folklore.\nThe title translates as \"Origins of the Spirit Fehuluni/ How did the Spirit Fehuluni appear\"." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 .

