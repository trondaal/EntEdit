wrk:1300171
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/1300171",
        "https://www.isfdb.org/cgi-bin/title.cgi?1300171" ;
    rdawd:P10223 "Сон смешного человека"@ru ;
    rdawd:P10086 "Son smeshnogo cheloveka" ;
    rdfs:label "Сон смешного человека (Фёдор Достоевский)" ;
    rdawd:P10219 "1877-04" ;
    rdawd:P10330 "\"Chronicles the experiences of a man who decides that there is nothing of any value in the world. Slipping into nihilism with the \"terrible anguish\" he is determined to commit suicide. A chance encounter with a young girl, however, begins the man on a journey that re-instills a love for his fellow man.\" (Wikipedia) After meeting the girl, he is plagued with guilt and has a vivid dream in which he shoots himself, is taken by an angel to a distant planet that is a utopia, and is responsible for the corruption of that utopia. After awakening he vows to make heaven on earth a reality.",
        "Everything fantastic in this story happens inside a dream." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:34771 .

