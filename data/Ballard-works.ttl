wrk:57639
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/57639",
        "https://www.isfdb.org/cgi-bin/title.cgi?57639" ;
    rdawd:P10223 "Made in U.S.A."@en ;
    rdfs:label "Made in U.S.A. (McIntosh, J. T.)" ;
    rdawd:P10219 "1953-04" ;
    rdawd:P10330 "A man sues his new wife for divorce as she didn't tell him before marriage that she is an \"android\". In this story \"an android\" means what a clone means today means. Androids are completely human, they are just artificially grown and have a stamp \"made in USA\" in their navels. For some undefined reason androids cannot have children and that is the grounds for the divorce. In principle the androids have exactly the same rights as humans, they don't ever have to tell if they are androids or not." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:368 .

