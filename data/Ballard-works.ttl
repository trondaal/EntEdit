wrk:54705
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/54705",
        "https://www.isfdb.org/cgi-bin/title.cgi?54705" ;
    rdawd:P10223 "The Lord of the Dynamos"@en ;
    rdfs:label "The Lord of the Dynamos (Wells, H. G.)" ;
    rdawd:P10219 "1894-09-06" ;
    rdawd:P10330 "The chief of a electricity plant is murdered by his companion because the latter believes the giant dynamo to be a god.\nThere's no supernatural element.\n(Source: Stonecreek)",
        "First published: Pall Mall Budget, 6th September 1894.\nAvailable on page 488, Bleiler (Gernsback)." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:65 .

wrk:54718
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/54718",
        "https://www.isfdb.org/cgi-bin/title.cgi?54718" ;
    rdawd:P10223 "The Man Who Could Work Miracles"@en ;
    rdfs:label "The Man Who Could Work Miracles (Wells, H. G.)" ;
    rdawd:P10219 "1898-06" ;
    rdawd:P10330 "Fotheringay discovers that he has the ability to think miracles into existence. After receiving encouragement from his clergyman, he begins to exercise his powers to help people, until he inadvertently thinks of Joshua, promptly stopping the Earth's rotation. A major catastrophe ensues, only to be undone by Fotheringay.",
        "First published in the 1898 Summer Number of the weekly Illustrated London News, a separately paginated annual special issue, with the subtitle \"A Pantoum in Prose\".\nProbably the subtitle appears in some publications whose database records do not report it.\nSee also Man Who Could Work Miracles (1936), the screen adaptation by Wells that was produced as a film in 1937." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:65 .

