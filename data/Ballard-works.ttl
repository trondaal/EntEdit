        "https://www.isfdb.org/cgi-bin/title.cgi?45879" ;
    rdawd:P10223 "Brightside Crossing"@en ;
    rdfs:label "Brightside Crossing (Nourse, Alan E.)" ;
    rdawd:P10219 "1956-01" ;
    rdawd:P10330 "A group tries to cross to sun side of Mercurius while it is closest to the sun. An old-timer who once attempted the same thing tries to warn them and tells his story." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:73 .

wrk:45882
    a rdac:C10001 ;
