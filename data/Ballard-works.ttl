wrk:83927
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/83927",
        "https://www.isfdb.org/cgi-bin/title.cgi?83927" ;
    rdawd:P10223 "Dracula's Guest"@en ;
    rdfs:label "Dracula's Guest (Stoker, Bram)" ;
    rdawd:P10219 "1914" ;
    rdawd:P10330 "\"Dracula's Guest tells the story of an unnamed Englishman visiting Munich before departing for Transylvania. Ignoring the warning of his hotelier to return early, the Englishman ventures out to explore an abandoned village. In this village, during a raging storm, he encounters several otherworldly beings and is unsure of the exact events of the night.\"\n-- summary, OCLC 852953282",
        "Written in 1897 as part of Dracula, this chapter was omitted from the published book for reasons of length.\n--so identified by Stoker's widow and literary executor in her 1914 Preface\n(disputed)\nOne point of entry is the 2006 Introduction by David Stuart Davies (see at ISFDB; Amazon provides a \"Look inside\" whose selection varies).\nAdapted for the movie Dracula's Daughter, a 1936 sequel to the 1931 Dracula.\n\"Ostensibly based on a short story titled \"Dracula's Guest\" by Bram Stoker, the film bears little or no resemblance to the original source material.\"\n--Wikipedia (May 2019)" ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:650 .

