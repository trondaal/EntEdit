wrk:1521615
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/1521615",
        "https://www.isfdb.org/cgi-bin/title.cgi?1521615" ;
    rdawd:P10223 "Soleil de soufre"@fr ;
    rdfs:label "Soleil de soufre (Brussolo, Serge)" ;
    rdawd:P10219 "1980" ;
    rdawd:P10330 "On an unnamed planet, the people have gone through a mutation that makes them insensitive to burning. Their whole civilization revolves around flammable materials, and the ever-present possibility for anything or anyone to catch fire : petrol gushes from fountains, artists make sculptures out of sulfur or phosphorus, etc. The narrator arrives in such a city, structured like a pyre; he has come to ritually set fire to it with a single match, then collect some of its ashes and carefully classify it in a small wooden box." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:847 .

