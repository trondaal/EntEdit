wrk:54646
    a rdac:C10001 ;
    rdaxd:P00018 "http://entedit.org/work/54646",
        "https://www.isfdb.org/cgi-bin/title.cgi?54646" ;
    rdawd:P10223 "The Crystal Egg"@en ;
    rdfs:label "The Crystal Egg (Wells, H. G.)" ;
    rdawd:P10219 "1897-05" ;
    rdawd:P10330 "An antique dealer finds out that one of his items (the crystal egg) allows views from a high post into alien life scenes. Upon close inspection, small lifeforms and structures can be seen inside the egg. With the help from the protagonist it can be determined from clues that the egg is in fact a viewer, and that he is viewing scenes from Mars.",
        "This story was first published in The New Review, May 1897. Though parts of it are set on Mars it has no part in Wells' \"The War of the Worlds\": there are seemingly different kinds of Martians, none of which resemble the ones from the novel." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 per:65 .

