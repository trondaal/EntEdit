    rdawd:P10223 "Time of Passage"@en ;
    rdfs:label "Time of Passage (Ballard, J. G.)" ;
    rdawd:P10219 "1964-02" ;
    rdawd:P10330 "In this world (Earth), some processes move backwards compared to our world. A coffin is dug out of the ground, the person inside is moved to a bed and starts breathing, etc. Eating, talking etc. seems to function normally. One remembers the past, but an emotional reaction to a future event is possible. In this world we follow a man from tomb to womb." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 <http://viaf.org/viaf/9842556> .

