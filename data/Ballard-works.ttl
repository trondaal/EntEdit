    rdawd:P10223 "Notes Towards a Mental Breakdown"@en ;
    rdfs:label "Notes Towards a Mental Breakdown (Ballard, J. G.)" ;
    rdawd:P10219 "1967-07" ;
    rdawd:P10330 "The text is totally different from the similarly named story which appeared in \"War Fever\". For some reason this story does not appear in the \"Complete Stories\" anthology. Some secondary sources, apparently mistakenly, list the title as \"Notes Toward a Mental Breakdown\". The text has been compared to that of \"The Death Module\" and is the same. The text has been compared to that of the the title in \"War Fever\" and \"Complete Stories\" and is not the same." ;
    entedit:P01 vtp:V1000 ;
    entedit:P02 entedit:T02 ;
    rdawo:P10061 <http://viaf.org/viaf/9842556> .

