exp:2722073
    a rdac:C10006 ;
    rdaxd:P00018 "http://entedit.org/expression/2722073",
        "https://www.isfdb.org/cgi-bin/title.cgi?2722073" ;
    rdaed:P20315 "In the Year 2889"@en ;
    rdfs:label "In the Year 2889 (Verne, Jules; Verne, Michel) [English, 1889]" ;
    rdaed:P20214 "1889-02" ;
    rdaed:P20071 "Translated by an unknown hand.\nThis is the first publication of the story.\nBased on correspondence, Jules Verne said it was entirely the work of Michel Verne. Neither Jules nor Michel had English this good, according to scholarship, so likely a translation of an unpublished text.\nThis translation begins:\n\"Little though they seem to think of it, the people of this twenty-ninth century live continually in fairyland. Surfeited as they are with marvels, they are indifferent in presence of each new marvel. To them all seems natural.\"" ;
    rdaeo:P20001 rdaco:1020 ;
    rdaeo:P20006 lang:eng ;
    rdaeo:P20231 wrk:2722043 ;
    rdaeo:P20141 exp:2722043 .

